# Copy to .env and fill in before `docker compose up`.

# --- LLM / embeddings (OpenAI-compatible — e.g. your own LiteLLM gateway) ---
LLM_BASE_URL=https://litellm.tecnologiaslan.co/v1
LLM_API_KEY=sk-changeme
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Admin panel login (single infra operator account, not multi-tenant) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme-use-a-real-password

# --- Ports (defaults match the sibling hermes-agent -> manty deploy pattern) ---
PROXY_PORT=8080
ADMIN_PORT=8090
# Exposes FalkorDB's own (third-party) Browser UI for manual/debug use —
# the admin panel's own graph viewer talks to FalkorDB directly and doesn't
# need this port, but it's handy to have open for raw Cypher queries.
FALKORDB_BROWSER_PORT=3000
