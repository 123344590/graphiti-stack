# Copy to .env and fill in before `docker compose up`.

# --- LLM / embeddings (OpenAI-compatible — e.g. your own LiteLLM gateway) ---
LLM_BASE_URL=https://litellm.tecnologiaslan.co/v1
LLM_API_KEY=sk-changeme
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Admin panel login (single infra operator account, not multi-tenant) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme-use-a-real-password

# --- Networking ---
# Host/IP reachable by whoever opens the admin panel (e.g. the ZeroTier or
# LAN address of this box) -- used to build the FalkorDB Browser link the
# admin panel's "Grafo" sidebar item opens (each agent's own graph, via
# FalkorDB Browser's own ?graph=<name> share-link param) and to tell that
# app's own auth what URL to trust itself at.
PUBLIC_HOST=localhost

# --- Ports (defaults match the sibling hermes-agent -> manty deploy pattern) ---
PROXY_PORT=8080
ADMIN_PORT=8090
# The official FalkorDB Browser (vendored with one source patch — see
# scripts/patch-browser-frame-embed.sh) -- embedded in the admin panel's
# Grafo page, pre-scoped to one agent's graph via its own share-link URL
# param. Not meant to be browsed to directly at the bare root; always
# reached through the admin panel.
FALKORDB_BROWSER_PORT=3002
